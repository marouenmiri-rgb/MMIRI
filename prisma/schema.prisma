// AdGen AI — local-first Prisma schema (SQLite).
//
// Enums are stored as String columns (SQLite doesn't support native enums).
// Allowed values live in src/lib/enums.ts; the application validates every
// write path with Zod. Keep them in sync when changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  plan       String   @default("FREE")
  createdAt  DateTime @default(now())

  ads               Ad[]
  leads             Lead[]
  campaigns         Campaign[]
  jobs              Job[]
  socialConnections SocialConnection[]
  socialPosts       SocialPost[]
  trackingLinks     TrackingLink[]
  conversions       Conversion[]
  adVariants        AdVariant[]
  insights          Insight[]
  subscription      Subscription?
  brandVoice        BrandVoice?
  autoPilotRules    AutoPilotRule[]
}

model Ad {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUrl    String
  productTitle  String?
  status        String   @default("QUEUED")
  scriptJson    Json?
  scenesJson    Json?
  voiceoverUrl  String?
  videoUrl      String?
  thumbnailUrl  String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]
  socialPosts   SocialPost[]
  trackingLinks TrackingLink[]
  variants      AdVariant[]

  @@index([userId, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  websiteUrl  String
  email       String?
  socialsJson Json?
  source      String?
  createdAt   DateTime @default(now())

  outreach    Outreach[]

  @@unique([userId, websiteUrl])
  @@index([userId, createdAt])
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  adId      String?
  ad        Ad?      @relation(fields: [adId], references: [id])
  status    String   @default("draft")
  createdAt DateTime @default(now())

  outreach  Outreach[]

  @@index([userId, createdAt])
}

model Outreach {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject    String
  body       String
  status     String    @default("DRAFT")
  sentAt     DateTime?
  openedAt   DateTime?
  repliedAt  DateTime?

  @@index([campaignId])
  @@index([leadId])
}

model Job {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  status      String   @default("QUEUED")
  payloadJson Json
  resultJson  Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, kind, status])
}

model SocialConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  handle       String?
  avatarUrl    String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  demo         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts        SocialPost[]

  @@unique([userId, platform])
  @@index([userId])
}

model SocialPost {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  adId         String
  ad           Ad               @relation(fields: [adId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      AdVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  platform     String
  caption      String
  scheduledFor DateTime
  status       String           @default("SCHEDULED")
  externalId   String?
  externalUrl  String?
  views        Int              @default(0)
  likes        Int              @default(0)
  comments     Int              @default(0)
  error        String?
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  trackingLink TrackingLink?

  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([adId])
  @@index([variantId])
}

model AdVariant {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adId       String
  ad         Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  kind       String   @default("HOOK")
  label      String
  angle      String?
  scriptJson Json
  winner     Boolean  @default(false)
  retired    Boolean  @default(false)
  createdAt  DateTime @default(now())

  socialPosts SocialPost[]

  @@index([adId, createdAt])
}

model TrackingLink {
  id             String      @id @default(cuid())
  code           String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adId           String?
  ad             Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)
  socialPostId   String?     @unique
  socialPost     SocialPost? @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  destinationUrl String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  clicks         Int         @default(0)
  conversions    Int         @default(0)
  revenueCents   Int         @default(0)
  currency       String      @default("USD")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  clickEvents  ClickEvent[]
  orderEvents  Conversion[]

  @@index([userId, createdAt])
  @@index([code])
}

model ClickEvent {
  id             String       @id @default(cuid())
  trackingLinkId String
  link           TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  occurredAt     DateTime     @default(now())
  ip             String?
  userAgent      String?
  referrer       String?
  country        String?

  @@index([trackingLinkId, occurredAt])
}

model Conversion {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingLinkId  String
  link            TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  externalOrderId String?
  revenueCents    Int
  currency        String       @default("USD")
  occurredAt      DateTime     @default(now())
  raw             Json?

  @@unique([trackingLinkId, externalOrderId])
  @@index([userId, occurredAt])
}

model Insight {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  body         String
  evidenceJson Json?
  actioned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 String    @default("FREE")
  status               String    @default("ACTIVE")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  revenueShareBps      Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
}

model BrandVoice {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  tone         String?
  audience     String?
  dosJson      Json?
  dontsJson    Json?
  examplesJson Json?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AutoPilotRule {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  enabled        Boolean   @default(true)
  productUrls    Json
  hookCategories Json?
  platforms      Json
  cadenceHours   Int       @default(24)
  budgetAdsTotal Int?
  adsRun         Int       @default(0)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([userId])
}
