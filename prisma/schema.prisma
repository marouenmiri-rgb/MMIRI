generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum AdStatus {
  QUEUED
  SCRAPING
  WRITING
  DIRECTING
  RENDERING
  READY
  FAILED
}

enum JobKind {
  AD_GENERATION
  SHOPIFY_DISCOVERY
  OUTREACH_SEND
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum OutreachStatus {
  DRAFT
  QUEUED
  SENT
  OPENED
  REPLIED
  BOUNCED
}

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  X
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String?
  plan       Plan       @default(FREE)
  createdAt  DateTime   @default(now())

  ads               Ad[]
  leads             Lead[]
  campaigns         Campaign[]
  jobs              Job[]
  socialConnections SocialConnection[]
  socialPosts       SocialPost[]
  trackingLinks     TrackingLink[]
  conversions       Conversion[]
  adVariants        AdVariant[]
  insights          Insight[]
}

model Ad {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUrl    String
  productTitle  String?
  status        AdStatus  @default(QUEUED)
  scriptJson    Json?
  scenesJson    Json?
  voiceoverUrl  String?
  videoUrl      String?
  thumbnailUrl  String?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaigns     Campaign[]
  socialPosts   SocialPost[]
  trackingLinks TrackingLink[]
  variants      AdVariant[]

  @@index([userId, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  websiteUrl  String
  email       String?
  socialsJson Json?
  source      String?
  createdAt   DateTime @default(now())

  outreach    Outreach[]

  @@unique([userId, websiteUrl])
  @@index([userId, createdAt])
}

model Campaign {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  adId       String?
  ad         Ad?      @relation(fields: [adId], references: [id])
  status     String   @default("draft")
  createdAt  DateTime @default(now())

  outreach   Outreach[]

  @@index([userId, createdAt])
}

model Outreach {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  status      OutreachStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?

  @@index([campaignId])
  @@index([leadId])
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        JobKind
  status      JobStatus @default(QUEUED)
  payloadJson Json
  resultJson  Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, kind, status])
}

model SocialConnection {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     SocialPlatform
  handle       String?
  avatarUrl    String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  demo         Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  posts        SocialPost[]

  @@unique([userId, platform])
  @@index([userId])
}

model SocialPost {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  adId         String
  ad           Ad               @relation(fields: [adId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      AdVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  platform     SocialPlatform
  caption      String
  scheduledFor DateTime
  status       SocialPostStatus @default(SCHEDULED)
  externalId   String?
  externalUrl  String?
  views        Int              @default(0)
  likes        Int              @default(0)
  comments     Int              @default(0)
  error        String?
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  trackingLink TrackingLink?

  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([adId])
  @@index([variantId])
}

enum VariantKind {
  HOOK
  ANGLE
  CTA
}

model AdVariant {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adId       String
  ad         Ad          @relation(fields: [adId], references: [id], onDelete: Cascade)
  kind       VariantKind @default(HOOK)
  label      String
  angle      String?
  scriptJson Json
  winner     Boolean     @default(false)
  retired    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  socialPosts SocialPost[]

  @@index([adId, createdAt])
}

model TrackingLink {
  id             String       @id @default(cuid())
  code           String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  adId           String?
  ad             Ad?          @relation(fields: [adId], references: [id], onDelete: SetNull)
  socialPostId   String?      @unique
  socialPost     SocialPost?  @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  destinationUrl String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  clicks         Int          @default(0)
  conversions    Int          @default(0)
  revenueCents   Int          @default(0)
  currency       String       @default("USD")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  clickEvents  ClickEvent[]
  orderEvents  Conversion[]

  @@index([userId, createdAt])
  @@index([code])
}

model ClickEvent {
  id             String       @id @default(cuid())
  trackingLinkId String
  link           TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  occurredAt     DateTime     @default(now())
  ip             String?
  userAgent      String?
  referrer       String?
  country        String?

  @@index([trackingLinkId, occurredAt])
}

model Conversion {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingLinkId  String
  link            TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  externalOrderId String?
  revenueCents    Int
  currency        String       @default("USD")
  occurredAt      DateTime     @default(now())
  raw             Json?

  @@unique([trackingLinkId, externalOrderId])
  @@index([userId, occurredAt])
}

enum InsightKind {
  WEEKLY_BRIEF
  WINNING_HOOK
  LOSING_HOOK
  BUDGET_SHIFT
}

model Insight {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      InsightKind
  title     String
  body      String
  evidenceJson Json?
  actioned  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}
