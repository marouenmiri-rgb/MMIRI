# ---------- Required (but defaulted) ----------
# SQLite is the default — no external DB needed.
# Switch to "postgresql://..." only if you need multi-user production.
DATABASE_URL="file:./dev.db"

# ---------- Highly recommended ----------
# Without this the dashboards render (fixtures) but AI agents won't run.
ANTHROPIC_API_KEY=""

# ---------- Optional · all graceful-degrade when absent ----------
ELEVENLABS_API_KEY=""     # voiceover; without it the video is silent
RESEND_API_KEY=""         # outreach + password reset email; without it links are logged to the server console
# The From address on account email. Must be a domain verified with Resend.
MAIL_FROM="AdGen <onboarding@resend.dev>"

# Stripe billing — without these the upgrade flow flips plans directly (demo mode).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_AGENCY=""

# Social OAuth — without these the Connect buttons use demo mode.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Shopify webhook — needed only if you wire real Shopify stores to /api/webhooks/shopify/orders.
SHOPIFY_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super admin — the account that signs up with this email gets role ADMIN.
ADMIN_EMAIL=""

# Protects /api/cron/publish-pending. Without it that endpoint is open: anyone
# who finds the URL can trigger already-scheduled posts to publish early.
# Set it in production and send it as `x-cron-secret` from your scheduler.
CRON_SECRET=""

# Development only. Lets the scraper reach a local or LAN host (a Shopify dev
# server, a fixture page). Ignored when NODE_ENV=production, so it cannot
# re-open SSRF on a live deployment. Leave empty unless you are testing.
ALLOW_PRIVATE_NETWORK_FETCH=""

# Folder of music beds laid under every ad (.mp3/.m4a/.wav). One is picked at
# random per render and ducked under the voiceover. Defaults to public/audio.
# Music is licensed — supply tracks you hold a licence for. Empty = silent.
MUSIC_DIR=""

# Stock b-roll from Pexels — free key at pexels.com/api. With it, the creative
# director can call for real footage on the beats a product photo cannot carry
# (steam rising, hands pouring) and cut it between your stills. Without it,
# every scene uses your own photographs, exactly as before.
PEXELS_API_KEY=""
# Development only: point the client at a local stand-in for the Pexels API.
# Leave empty in production.
PEXELS_API_BASE=""
