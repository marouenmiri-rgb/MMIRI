# ---------- Required (but defaulted) ----------
# SQLite is the default — no external DB needed.
# Switch to "postgresql://..." only if you need multi-user production.
DATABASE_URL="file:./prisma/dev.db"

# ---------- Highly recommended ----------
# Without this the dashboards render (fixtures) but AI agents won't run.
ANTHROPIC_API_KEY=""

# ---------- Optional · all graceful-degrade when absent ----------
ELEVENLABS_API_KEY=""     # voiceover; without it the video is silent
RESEND_API_KEY=""         # outreach email delivery; without it outreach stays as DRAFTs

# Stripe billing — without these the upgrade flow flips plans directly (demo mode).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_AGENCY=""

# Social OAuth — without these the Connect buttons use demo mode.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Shopify webhook — needed only if you wire real Shopify stores to /api/webhooks/shopify/orders.
SHOPIFY_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3PL Finder — used to substitute {ref} in affiliate URLs and personalize outreach.
THREEPL_AFFILIATE_REF=""
THREEPL_SENDER_NAME=""
